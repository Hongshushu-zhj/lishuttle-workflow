# ============================================================
# 任务单样例：广州路损计算（-f pl）
#
# 这就是"一份任务单跑两种模式"的核心：
# 里面的路径用 ${...} 引用环境变量，所以同一个文件
#   python  scripts\render_schema.py jobs\example-pl-guangzhou.env local-win
#   python3 scripts/render_schema.py jobs/example-pl-guangzhou.env server
# 能渲染出本地和服务器两套正确的运行单，不需要手工改路径。
#
# 复制这个文件改名即可新建任务。
#
# 格式同 env 文件：KEY="VALUE"，路径用正斜杠。
# ============================================================

# ---------- 任务标识 ----------
# 任务名：写进运行单的 name 属性，同时决定输出目录名。
# 输出目录 = ${OUT_ROOT}/<JOB_NAME>/
# （程序会把 name 属性追加到 PathlossDirectory 后面，所以别把任务名
#   再写进 PathlossDirectory，否则目录名会重复两层。）
JOB_NAME="pl-guangzhou"

# 运行单文件名。刻意带上任务名，不用通用的 runtimeschema.xml——
# 因为 stage 步骤会把 ThirdPart\Config\runtimelibrary\ 里的原版
# 运行单复制到 exe 旁边，如果这里也叫 runtimeschema.xml，
# 你渲染的成果会被覆盖掉。带任务名就互不干扰。
SCHEMA_NAME="${JOB_NAME}.xml"

# -f 参数：功能
#   可用值（来自 readme.txt）：debug test pl plindoor dt cali acp ai
#                              rays indoorrays scene debugbuild commsensing
FUNC="pl"

# -t 参数：任务ID，可选，留空则程序内部默认为 0
TASK_ID="1"

# ---------- 数据定位 ----------
# 城市名：对应 ${MAP_ROOT}/<城市>/ 下的 heights/ clutter/ buildings/ buildvector/
# guangzhou 为示例城市目录名，请按实际数据修改。
CITY="guangzhou"

# 工参 CSV（工程参数表）。
#
# 【重要】必须用完整字段版本（44 列），不能用地图目录里那份 37 列的
# map/guangzhou/guangzhougongcan.csv。原因：程序解析到第 40 个字段
# （感知功率 sensePower）时要求非空（NetEntity/src/CellLoader.cpp:865），
# 而 37 列版本没有通感相关列，会直接报
#   "An error occured while parsing the 40th filed!"
# 请从引擎项目维护者处获取字段完整、版本匹配的工参样例。
#
# 命名约定和服务器一致：工参和区域多边形都放在 ${CASE_ROOT} 下，
# 用任务名命名，这样同一份任务单在本地和服务器上都成立。
ENGINEERING_FILE="${CASE_ROOT}/${JOB_NAME}.csv"

# 区域多边形：WGS84 经纬度，每行 "经度,纬度" 一个顶点，首尾点重复。
POLYGON_FILE="${CASE_ROOT}/${JOB_NAME}.txt"

# ---------- 可选的覆盖项（留空则用默认值） ----------
# 高度分层：MaxCalcHeight/DefaultFloorHeight = 输出层数。
# 留空 = 3m 单层。若需要输出
# 10m/20m/.../100m 多层，就设 MAX_CALC_HEIGHT="100" DEFAULT_FLOOR_HEIGHT="10"
MAX_CALC_HEIGHT=""
DEFAULT_FLOOR_HEIGHT=""
# 杂波匹配配置。留空则用 ${MAP_ROOT}/${CITY}/<城市名>cluttermatchsettings.xml
CLUTTER_MATCH_FILE=""

# 场景配置。留空则用 <exe目录>/runtimelibrary/scenesettings.xml
SCENE_SETTINGS_FILE=""

# 路测数据目录（-f dt / -f cali 需要）
DRIVETEST_DIR=""

# ---------- 运行控制 ----------
# 是否在运行前自动渲染运行单（1=是，0=否，只想重跑不重渲染时设 0）
RENDER_BEFORE_RUN="1"

# 服务器上是否用 nohup 后台运行（1=是，适合长时间任务；0=前台）
# 长任务建议设 1，否则 SSH 断开任务就死了。本地模式忽略此项。
SERVER_BACKGROUND="1"
