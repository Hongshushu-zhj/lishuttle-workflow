# ============================================================
# 任务单样例：室内路损/覆盖预测（MapFormat=indoor）
#
# 室内路损使用 plindoor；室内覆盖预测使用 predindoor（需引擎支持）。
# pred 是室外预测功能，不应搭配室内 schema。
#
# 复制改名即可新建室内任务。
# ============================================================

# ---------- 任务标识 ----------
JOB_NAME="plindoor-sjy"

# 运行单文件名带任务名，避免被 stage 复制的同名文件覆盖
SCHEMA_NAME="${JOB_NAME}.xml"

# 功能：plindoor（室内路损计算）或 predindoor（室内覆盖预测）
FUNC="plindoor"
TASK_ID="1"

# 用室内模板
TEMPLATE="runtimeschema-indoor.xml.tpl"

# ---------- 数据定位 ----------
# 室内地图目录（里面就一个 building.das）
# sjy 为示例场景目录名，请替换为实际场景，确保目录中存在 building.das。
MAP_PATH="${MAP_ROOT}/sjy"

# 室内工参：AP 位置表（AP ID/Floor/x/y/天线/功率...）
# ap-single.csv 是室内 AP 工参样例
ENGINEERING_FILE="${CASE_ROOT}/${JOB_NAME}.csv"

# 区域多边形：室内任务可以留空（模板里会渲染成空标签）
POLYGON_FILE=""

# ---------- 可选的覆盖项（留空则用默认值） ----------
CLUTTER_MATCH_FILE=""
SCENE_SETTINGS_FILE=""
DRIVETEST_DIR=""

# ---------- 运行控制 ----------
RENDER_BEFORE_RUN="1"
SERVER_BACKGROUND="1"
