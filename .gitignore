# Machine-specific environment settings (paths, SSH host/user/key location).
# Keep sanitized templates such as env/local-win.env.example in Git.
.env
.env.*
!.env.example
!.env.template
/env/*.env
/env/*.env.*
!/env/local-win.env.example

# Local platform adjustment notes.
/docs/

# Local task sheets; retain the reusable examples.
/jobs/*
!/jobs/example-pl-guangzhou.env
!/jobs/example-plindoor-sjy.env

# Python bytecode, virtual environments, and tool caches.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Downloaded results, generated runtime files, and build output.
/results/
/outputs/
/out/
/build/
/dist/
/runtimelibrary/
/map/
/case/
/gongcan/
/tasks/
/drivetest/
/pathloss/
/project/
*.xml.manifest.json
*.log
*_log.txt
*.pid
jobstatus_*

# Editor settings and operating-system files.
.vs/
.vscode/
.idea/
.history/
.codex/
.agents/
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files and local backups.
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# SSH private keys and local credentials.
.ssh/
.aws/
.azure/
.npmrc
.pypirc
.netrc
credentials.json
service-account*.json
secrets.json
secrets.yaml
secrets.yml
.secrets/
id_rsa
id_rsa_*
id_dsa
id_dsa_*
id_ecdsa
id_ecdsa_*
id_ed25519
id_ed25519_*
*.pem
*.key
*.p12
*.pfx
*.ppk

# Local archives, data stores, crash dumps, and compiled engine binaries.
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.db
*.sqlite
*.sqlite3
*.dmp
*.exe
*.dll
*.pdb
*.obj
*.lib
