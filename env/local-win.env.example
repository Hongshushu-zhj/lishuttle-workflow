# 本地 Windows 配置示例。复制为 local-win.env 后按实际环境修改。
# 文件编码：UTF-8；格式：KEY="VALUE"；路径统一使用正斜杠 /。
# 以下路径仅为示例，不代表已安装工具或已提供数据。
# 建议让能访问本机文件的 AI 按 README 的提示词协助填写。

# LiShuttle C++ 项目根目录，必须包含 CMakeLists.txt 和 CMakePresets.json。
PROJECT_DIR="D:/LiShuttle/LabProject"
# 必须与该项目 CMakePresets.json 中的实际预设、输出目录一致。
PRESET="x64-release"
BUILD_SUBDIR="out/build/x64-release"
INSTALL_SUBDIR="out/install/x64-release"
EXE_NAME="lishuttle.exe"

# VS2022 安装路径示例；Community/Professional/Enterprise/BuildTools 按实际修改。
# CMAKE、NINJA、VCVARS 均填写确实存在的文件绝对路径。
VS_ROOT="C:/Program Files/Microsoft Visual Studio/2022/Community"
CMAKE="C:/Program Files/Microsoft Visual Studio/2022/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe"
NINJA="C:/Program Files/Microsoft Visual Studio/2022/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe"
VCVARS="C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Auxiliary/Build/vcvars64.bat"

# 相对于 PROJECT_DIR；DLL 必须与所选预设/构建配置匹配。
CONFIG_SRC="ThirdPart/Config"
DLL_SRC="ThirdPart/Dll/Release"

# 地图根目录：每个城市/室内场景一个子目录。
MAP_ROOT="D:/LiShuttle/map"
# CLI 示例任务使用的工参及区域文件目录。
CASE_ROOT="D:/LiShuttle/case"
# 所有任务的计算结果根目录，需要可写权限。
OUT_ROOT="D:/LiShuttle/outputs"
# 路测/校正任务的数据目录；不用相关功能时可保留此路径。
DT_ROOT="D:/LiShuttle/drivetest"
# Web 平台扫描的任务根目录：每个任务一个子文件夹。
GONGCAN_ROOT="D:/LiShuttle/tasks"
