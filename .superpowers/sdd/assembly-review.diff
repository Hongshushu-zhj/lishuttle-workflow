+      classList:{add:c=>classes.add(c),remove:c=>classes.delete(c),contains:c=>classes.has(c),toggle(){}},
+      focus(){}, scrollIntoView(){}, querySelectorAll(){return [];} });
+  }
+  return nodes.get(id);
+}
