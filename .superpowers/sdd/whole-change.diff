diff --git a/platform/backend/managed_process.py b/platform/backend/managed_process.py
new file mode 100644
index 0000000..dca186a
--- /dev/null
+++ b/platform/backend/managed_process.py
@@ -0,0 +1,124 @@
+"""Own the process tree, including children whose original parent has exited."""
+
+import os
+import signal
+import subprocess
+import time
+
+
+class ManagedProcess:
+    def __init__(self, cmd, cwd, env=None):
+        self.job = None
+        self.proc = None
+        options = dict(cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                       text=True, encoding='gbk', errors='replace', shell=False, env=env)
+        if os.name == 'nt':
+            self._windows_job()
+            try:
+                # Assign before any engine/build code can spawn unowned children.
+                self.proc = subprocess.Popen(cmd, creationflags=0x4 | subprocess.CREATE_NEW_PROCESS_GROUP, **options)
+                if not self.kernel.AssignProcessToJobObject(self.job, int(self.proc._handle)):
+                    raise self.ctypes.WinError(self.ctypes.get_last_error())
+                ntdll = self.ctypes.WinDLL('ntdll')
+                ntdll.NtResumeProcess.argtypes = [self.wintypes.HANDLE]
+                ntdll.NtResumeProcess.restype = self.wintypes.LONG
+                status = ntdll.NtResumeProcess(int(self.proc._handle))
+                if status < 0:
+                    raise OSError(f'无法恢复受管进程：NTSTATUS {status:#x}')
+            except BaseException:
+                if self.proc is not None:
+                    self.proc.kill()
+                    self.proc.wait()
+                    if self.proc.stdout:
+                        self.proc.stdout.close()
+                self.close()
+                raise
+        else:
+            self.proc = subprocess.Popen(cmd, start_new_session=True, **options)
+
+    def _windows_job(self):
+        import ctypes
+        from ctypes import wintypes
+        self.ctypes, self.wintypes = ctypes, wintypes
+        self.kernel = ctypes.WinDLL('kernel32', use_last_error=True)
+
+        class Limits(ctypes.Structure):
+            _fields_ = [('process_time', ctypes.c_int64), ('job_time', ctypes.c_int64),
+                        ('flags', wintypes.DWORD), ('min_working', ctypes.c_size_t),
+                        ('max_working', ctypes.c_size_t), ('active_limit', wintypes.DWORD),
+                        ('affinity', ctypes.c_size_t), ('priority', wintypes.DWORD),
+                        ('scheduling', wintypes.DWORD)]
+
+        class IO(ctypes.Structure):
+            _fields_ = [(name, ctypes.c_uint64) for name in
+                        ('read_ops', 'write_ops', 'other_ops', 'read_bytes', 'write_bytes', 'other_bytes')]
+
+        class ExtendedLimits(ctypes.Structure):
+            _fields_ = [('basic', Limits), ('io', IO), ('process_memory', ctypes.c_size_t),
+                        ('job_memory', ctypes.c_size_t), ('peak_process', ctypes.c_size_t),
+                        ('peak_job', ctypes.c_size_t)]
+
+        class Accounting(ctypes.Structure):
+            _fields_ = [(name, ctypes.c_int64) for name in
+                        ('user_time', 'kernel_time', 'period_user', 'period_kernel')] + [
+                            ('faults', wintypes.DWORD), ('total', wintypes.DWORD),
+                            ('active', wintypes.DWORD), ('terminated', wintypes.DWORD)]
+
+        self.Accounting = Accounting
+        api = self.kernel
+        api.CreateJobObjectW.argtypes = [ctypes.c_void_p, wintypes.LPCWSTR]
+        api.CreateJobObjectW.restype = wintypes.HANDLE
+        api.SetInformationJobObject.argtypes = [wintypes.HANDLE, ctypes.c_int, ctypes.c_void_p, wintypes.DWORD]
+        api.SetInformationJobObject.restype = wintypes.BOOL
+        api.AssignProcessToJobObject.argtypes = [wintypes.HANDLE, wintypes.HANDLE]
+        api.AssignProcessToJobObject.restype = wintypes.BOOL
+        api.QueryInformationJobObject.argtypes = [wintypes.HANDLE, ctypes.c_int, ctypes.c_void_p,
+                                                  wintypes.DWORD, ctypes.c_void_p]
+        api.QueryInformationJobObject.restype = wintypes.BOOL
+        api.TerminateJobObject.argtypes = [wintypes.HANDLE, wintypes.UINT]
+        api.TerminateJobObject.restype = wintypes.BOOL
+        api.CloseHandle.argtypes = [wintypes.HANDLE]
+        api.CloseHandle.restype = wintypes.BOOL
+        self.job = api.CreateJobObjectW(None, None)
+        if not self.job:
+            raise ctypes.WinError(ctypes.get_last_error())
+        limits = ExtendedLimits()
+        limits.basic.flags = 0x2000  # JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
+        if not api.SetInformationJobObject(self.job, 9, ctypes.byref(limits), ctypes.sizeof(limits)):
+            error = ctypes.WinError(ctypes.get_last_error())
+            self.close()
+            raise error
+
+    def active(self):
+        if os.name == 'nt':
+            accounting = self.Accounting()
+            if not self.kernel.QueryInformationJobObject(self.job, 1, self.ctypes.byref(accounting),
+                                                          self.ctypes.sizeof(accounting), None):
+                raise self.ctypes.WinError(self.ctypes.get_last_error())
+            return accounting.active > 0
+        try:
+            os.killpg(self.proc.pid, 0)
+            return True
+        except ProcessLookupError:
+            return False
+
+    def terminate(self):
+        if os.name == 'nt':
+            if not self.kernel.TerminateJobObject(self.job, 1):
+                raise self.ctypes.WinError(self.ctypes.get_last_error())
+        else:
+            try:
+                os.killpg(self.proc.pid, signal.SIGKILL)
+            except ProcessLookupError:
+                pass
+
+    def wait(self):
+        code = self.proc.wait()
+        while self.active():
+            time.sleep(.05)
+        return code
+
+    def close(self):
+        if self.job:
+            self.kernel.CloseHandle(self.job)
+            self.job = None
diff --git a/platform/backend/preflight.py b/platform/backend/preflight.py
new file mode 100644
index 0000000..374e57e
--- /dev/null
+++ b/platform/backend/preflight.py
@@ -0,0 +1,804 @@
+"""Read-only checks for the reviewed engine's real inputs and layer semantics.
+
+Paths in XML are interpreted from Bin, exactly like the launched process. This
+module deliberately does not stage files, create output folders or repair XML.
+"""
+import csv
+import codecs
+import hashlib
+import io
+import math
+import os
+from pathlib import Path
+import re
+import shlex
+import struct
+import xml.etree.ElementTree as ET
+
+from engineering import engineering_kind, normalized
+
+
+def _path(value, base):
+    if not value:
+        return ''
+    return str(Path(os.path.abspath(os.path.join(str(base), str(value).replace('\\', os.sep)))))
+
+
+def _text(path):
+    raw = Path(path).read_bytes()
+    for encoding in ('utf-8-sig', 'gb18030'):
+        try:
+            return raw.decode(encoding)
+        except UnicodeError:
+            pass
+    raise ValueError('文件不是 UTF-8 或 GB18030 文本')
+
+
+def _number(value):
+    try:
+        result = float(value)
+        return result if math.isfinite(result) else None
+    except (TypeError, ValueError, OverflowError):
+        return None
+
+
+def _bool(params, tag, default=True):
+    value = str(params.get(tag, str(default))).lower()
+    if value in ('false', '0'):
+        return False
+    if value in ('true', '1'):
+        return True
+    return default
+
+
+def _open_text(path):
+    """Choose supported text encoding without loading large data into memory."""
+    with open(path, 'rb') as fh:
+        sample = fh.read(65536)
+    for encoding in ('utf-8-sig', 'gb18030'):
+        try:
+            codecs.getincrementaldecoder(encoding)().decode(sample, final=False)
+            return open(path, encoding=encoding, newline='')
+        except UnicodeError:
+            pass
+    raise ValueError('文件不是 UTF-8 或 GB18030 文本')
+
+
+def _xml_fragments(path):
+    text = re.sub(r'<\?xml\b.*?\?>', '', _text(path), flags=re.S)
+    return ET.fromstring('<Document>' + text + '</Document>')
+
+
+def _cell_columns(bin_dir, issue):
+    # CellLoader.h defaults remain in force if parsing Bin/cellformat.xml fails.
+    columns = dict(CellId=0, PCI=7, BandWidth=17, ChannelNumber=18, MaxPower=15, EPRE=16,
+        SensePower=16, PropagationModel=19, CalcRadius=23, SiteId=2, Longitude=4, Latitude=5,
+        TxNumber=13, RxNumber=14, Antenna=12, SenseAntenna=12, AntennaHeight=8,
+        Azimuth=9, Tilt=10, ElecTilt=11, SenseTilt=11, CellType=34, CityCode=-1)
+    headers = 2
+    path = str(Path(bin_dir) / 'cellformat.xml')
+    try:
+        document = _xml_fragments(path)
+        parsed = {}
+        for root in document.findall('TableFormat'):
+            for node in root:
+                value = node.text or ''
+                if node.tag == 'HeaderLines':
+                    try:
+                        count = int(value)
+                        if count >= 0:
+                            headers = count
+                    except ValueError:
+                        pass
+                elif re.fullmatch('[A-Za-z]+', value):
+                    col = 0
+                    for ch in value.upper():
+                        col = col * 26 + ord(ch) - 64
+                    parsed.setdefault(node.tag, col - 1)
+        columns.update(parsed)
+        for target, fallback in (('SensePower', 'EPRE'), ('SenseAntenna', 'Antenna'), ('SenseTilt', 'ElecTilt')):
+            if target not in parsed:
+                columns[target] = columns[fallback]
+    except (OSError, ValueError, ET.ParseError) as exc:
+        issue('warning', 'ENGINEERING_FORMAT_DEFAULT', f'未加载 Bin/cellformat.xml，使用 CellLoader.h 默认列布局：{exc}', 'EngineeringFilePath', path)
+    return columns, headers
+
+
+_COLUMN_LABELS = {
+    'CellId': ('Cell ID', '小区ID'), 'SiteId': ('Site ID', '基站ID'),
+    'Longitude': ('Longitude', '经度'), 'Latitude': ('Latitude', '纬度'),
+    'AntennaHeight': ('Height (m)', 'Antenna Height', '天线高度'),
+    'Azimuth': ('Azimuth (°)', 'Azimuth', '天线方位角'),
+    'Tilt': ('Mechanical Downtilt (°)', '机械下倾角'),
+    'Antenna': ('Antenna', '天线型号'), 'EPRE': ('EPRE per antenna port', '参考信号功率'),
+    'ChannelNumber': ('Channel Number', '频点'), 'PropagationModel': ('Main Propagation Model', '预测模型'),
+    'TxNumber': ('Number of Transmission Antennas', '天线发射端口数量'),
+    'RxNumber': ('Number of Reception Antennas', '天线接收端口数量'),
+    'MaxPower': ('Max Power (dBm)', '最大发射功率'), 'CellType': ('Cell Type', '小区类型'),
+    'ApId': ('AP ID',), 'Floor': ('Floor', '楼层'), 'x': ('x', 'x坐标'), 'y': ('y', 'y坐标'),
+}
