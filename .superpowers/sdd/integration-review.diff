+    (out.length ? `<div class="panel-title" style="margin-top:4px">室外城市</div>` : "") +
+    out.map(item).join("") +
+    (ind.length ? `<div class="panel-title" style="margin-top:8px">室内场景</div>` : "") +
+    ind.map(item).join("");
