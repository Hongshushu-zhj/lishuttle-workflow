+      (profile.scene_warning ? `<p class="param-warning">${esc(profile.scene_warning)}</p>` : '') +
+      (required.length ? `<p class="param-warning">本功能强制读取的元素在当前 XML 中缺失：${esc(required.join('、'))}。请核对所选运行配置；不会自动补写或覆盖参数。</p>` : '') +
